FROM node:22-alpine AS deps

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci

FROM node:22-alpine AS builder

WORKDIR /app

COPY frontend ./frontend
COPY HV-Muse-Regular.otf ./HV-Muse-Regular.otf

WORKDIR /app/frontend

COPY --from=deps /app/frontend/node_modules ./node_modules

ENV NODE_ENV=production
ENV BACKEND_INTERNAL_URL=http://backend:5000
ENV NEXT_PUBLIC_SITE_URL=https://rashikapoor.co.in
ENV NEXT_PUBLIC_API_URL=
ENV NEXT_PUBLIC_CAREERS_URL=/careers

RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app/frontend

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
ENV BACKEND_INTERNAL_URL=http://backend:5000

COPY --from=builder /app/frontend/.next ./.next
COPY --from=builder /app/frontend/Public ./public
COPY --from=builder /app/frontend/package.json ./package.json
COPY --from=builder /app/frontend/node_modules ./node_modules
COPY --from=builder /app/frontend/next.config.mjs ./next.config.mjs

EXPOSE 3000

CMD ["npm", "start", "--", "-p", "3000"]
