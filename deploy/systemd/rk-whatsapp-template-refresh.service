[Unit]
Description=Read Meta WhatsApp inventory into the guarded production cache
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apps/rashi-kapoor/rk-web
EnvironmentFile=/etc/rk-whatsapp/images.env
ExecStartPre=/usr/bin/python3 scripts/whatsapp_images.py validate --pins /etc/rk-whatsapp/images.env --require-running
ExecStart=/usr/bin/flock -E 75 -n /run/lock/rk-whatsapp-template-refresh.lock /usr/bin/docker compose -f docker-compose.yml -f deploy/docker-compose.release.yml -f deploy/docker-compose.worker.yml run --rm --no-deps --pull never --name rk-whatsapp-template-refresh backend python -m flask --app wsgi:app whatsapp-template-refresh
SuccessExitStatus=75
TimeoutStartSec=10min
StandardOutput=journal
StandardError=journal
