[Unit]
Description=RK WhatsApp bounded queue worker
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/apps/rashi-kapoor/rk-web
EnvironmentFile=/etc/rk-whatsapp/images.env
ExecStartPre=/usr/bin/python3 scripts/whatsapp_images.py validate --pins /etc/rk-whatsapp/images.env --require-running
ExecStart=/usr/bin/flock -E 75 -n /run/lock/rk-whatsapp-worker.lock /usr/bin/docker compose -f docker-compose.yml -f deploy/docker-compose.release.yml -f deploy/docker-compose.worker.yml run --rm --no-deps --pull never --name rk-whatsapp-worker backend python -m flask --app wsgi:app whatsapp-worker
ExecStop=-/usr/bin/docker stop --time 90 rk-whatsapp-worker
SuccessExitStatus=75
TimeoutStartSec=1h
TimeoutStopSec=100s
StandardOutput=journal
StandardError=journal
