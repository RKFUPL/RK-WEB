# Image references only. No application/provider credentials belong here.
# Replace both placeholders before installation; preserve existing server files.
# The root-owned host helper --sync writes inspectable RepoDigests; repo validation is read-only.
# Local builds without RepoDigests fail closed; never substitute a tag or Image ID.
RK_BACKEND_IMAGE=REPLACE_WITH_REVIEWED_BACKEND_IMAGE
RK_FRONTEND_IMAGE=REPLACE_WITH_REVIEWED_FRONTEND_IMAGE
