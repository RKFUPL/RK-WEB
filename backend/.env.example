FLASK_ENV=development
# Generate independent, high-entropy values (at least 32 bytes) for production.
SECRET_KEY=
JWT_SECRET_KEY=
AUTH_SESSION_DAYS=30
SHARED_SESSION_COOKIE_NAME=rk_shared_session
SHARED_SESSION_COOKIE_DOMAIN=.rashikapoor.co.in
# Zoho Mail is backend-only. Never place these values in frontend env files.
# SMTP_HOST/PORT/SECURE/USERNAME/PASSWORD are also supported aliases.
ZOHO_MAILBOX=rk@rashikapoorofficial.com
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURITY=starttls
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Twelve Data stays disabled until commercial storefront use is contractually approved.
TWELVE_DATA_API_KEY=
TWELVE_DATA_COMMERCIAL_USE_APPROVED=false

# Razorpay local development uses Test Mode credentials only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# Official Meta Cloud API. Secrets stay in the backend environment only.
# Production safe defaults. Local overrides belong in ignored .env.local.
WHATSAPP_ENVIRONMENT=production
WHATSAPP_ENABLED=false
# Local admin test sends only. Ignored by the production configuration class.
WHATSAPP_TEST_SEND_ENABLED=false
# Additional campaign gate; also requires normal automation + database integration gates.
WHATSAPP_MARKETING_ENABLED=false
# Explicit canonical domain for approved dynamic template URL definitions.
WHATSAPP_CANONICAL_URL=https://rashikapoor.co.in
# HTTPS tunnel URL ending /api/webhooks/whatsapp; no production fallback locally.
WHATSAPP_DEVELOPMENT_CALLBACK_URL=
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Fernet key generated separately; encrypts short-lived queued delivery payloads.
WHATSAPP_OUTBOX_KEY=
# Merge event mappings; legacy approved entries remain compatible.
# Catalogue/name/category/language/parameters/types/approvalStatus/enabled:
# see docs/WHATSAPP_TEMPLATE_SUBMISSIONS.md. All defaults are unapproved/off.
WHATSAPP_TEMPLATES={}
# Explicit target for guarded worker/refresh commands; must equal DB_NAME/URI.
WHATSAPP_EXPECTED_DATABASE=
# Processing lease, not retention. Inbox/event/outbox TTL policy is unchanged.
WHATSAPP_WORKER_LEASE_SECONDS=300
# Opt in only after the VPS proxy chain has been verified. Zero ignores XFF.
TRUSTED_PROXY_HOPS=0
