AUTH_SESSION_DAYS=30
SHARED_SESSION_COOKIE_NAME=rk_shared_session
SHARED_SESSION_COOKIE_DOMAIN=.rashikapoor.co.in
# Zoho Mail is backend-only. Never place these values in frontend env files.
MAIL_PROVIDER=resend
ZOHO_MAILBOX=rk@rashikapoorofficial.com
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURITY=starttls
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# Twelve Data stays disabled until commercial storefront use is contractually approved.
TWELVE_DATA_API_KEY=
TWELVE_DATA_COMMERCIAL_USE_APPROVED=false

# Razorpay local development uses Test Mode credentials only.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test
