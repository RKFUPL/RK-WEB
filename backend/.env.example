# Service-to-service connection from RK-STOCK. Keep the secret server-side only.
STOCK_INTEGRATION_BOOTSTRAP_SECRET=
STOCK_INTEGRATION_CLIENT_ID=rk-stock-linesheets
STOCK_INTEGRATION_CATALOG_WRITE_ENABLED=false
STOCK_INTEGRATION_CLOUDINARY_HOST=res.cloudinary.com
# Optional local RK-STOCK credential-sync receiver. Never put user passwords here.
STOCK_CREDENTIAL_SYNC_URL=
STOCK_CREDENTIAL_SYNC_SECRET=
CREDENTIAL_SYNC_HANDOFF_SECRET=
CREDENTIAL_SYNC_HANDOFF_TTL_SECONDS=60
# Shared first-party session authority for RK-STOCK. Keep secret server-side.
AUTH_SESSION_DAYS=30
SHARED_SESSION_COOKIE_NAME=rk_shared_session
SHARED_SESSION_COOKIE_DOMAIN=.rashikapoor.co.in
SHARED_SESSION_INTERNAL_SECRET=
# Zoho Mail is backend-only. Never place these values in frontend env files.
MAIL_PROVIDER=resend
ZOHO_MAILBOX=rk@rashikapoorofficial.com
ZOHO_SMTP_HOST=smtppro.zoho.com
ZOHO_SMTP_PORT=587
ZOHO_SMTP_SECURITY=starttls
ZOHO_SMTP_USERNAME=
ZOHO_SMTP_PASSWORD=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
